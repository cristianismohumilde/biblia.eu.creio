    "sourceTexts": {
        "hebrew": "וַיְהִי עֶרֶב וַיְהִי בֹקֶר יוֹם חֲמִישִׁי",
        "aramaic": "וַהֲוָה רְמַשׁ וַהֲוָה צְפַר יוֹמָא חֲמִישָׁאָה",
        "greek": "καὶ ἐγένετο ἑσπέρα καὶ ἐγένετο πρωί ἡμέρα πέμπτη",
        "latin": "et factum est vespere et mane dies quintus",
        "geez": "ወኮነ ሠርክ ወኮነ ነግህ ኃምስ ዕለት",
