    "sourceTexts": {
        "hebrew": "וַיְהִי עֶרֶב וַיְהִי בֹקֶר יוֹם שְׁלִישִׁי",
        "aramaic": "וַהֲוָה רְמַשׁ וַהֲוָה צְפַר יוֹמָא תְּלִיתָאָה",
        "greek": "καὶ ἐγένετο ἑσπέρα καὶ ἐγένετο πρωί ἡμέρα τρίτη",
        "latin": "et factum est vespere et mane dies tertius",
        "geez": "ወኮነ ሠርክ ወኮነ ነግህ ሣልስ ዕለት",
        "syriac": "ܘܗܘܐ ܪܡܫܐ ܘܗܘܐ ܨܦܪܐ ܝܘܡܐ ܬܠܝܬܝܐ",
        "coptic": "uoh a ruhan shōpi uoh a htoou shōpi p-huu n-mah-shomt",
        "armenian": "Եւ եղեւ ընդ երեկս եւ եղեւ ընդ առաւօտս օր երրորդ:"
    },
