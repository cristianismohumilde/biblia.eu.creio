    "sourceTexts": {
        "hebrew": "וַיִּבְרָא אֱלֹהִים אֶת הָאָדָם בְּצַלְמוֹ בְּצֶלֶם אֱלֹהִים בָּרָא אֹתוֹ זָכָר וּנְקֵבָה בָּרָא אֹתָם",
        "aramaic": "Aramaic targum text...",
        "greek": "καὶ ἐποίησεν ὁ θεὸς τὸν ἄνθρωπον κατ' εἰκόνα θεοῦ ἐποίησεν αὐτόν ἄρσεν καὶ θῆλυ ἐποίησεν αὐτούς",
        "latin": "et creavit Deus hominem ad imaginem suam ad imaginem Dei creavit illum masculum et feminam creavit eos",
        "geez": "Ge'ez text...",
        "syriac": "Syriac text...",
