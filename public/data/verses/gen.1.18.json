    "sourceTexts": {
        "hebrew": "וְלִמְשֹׁל בַּיּוֹם וּבַלַּיְלָה וּלְהַבְדִּיל בֵּין הָאוֹר וּבֵין הַחֹשֶׁךְ וַיַּרְא אֱלֹהִים כִּי טוֹב",
        "aramaic": "Aramaic targum text...",
        "greek": "καὶ ἄρχειν τῆς ἡμέρας καὶ τῆς νυκτὸς καὶ διαχωρίζειν ἀνὰ μέσον τοῦ φωτὸς καὶ ἀνὰ μέσον τοῦ σκότους καὶ εἶδεν ὁ θεὸς ὅτι καλόν",
        "latin": "et praeessent diei ac nocti et dividerent lucem ac tenebras et vidit Deus quod esset bonum",
        "geez": "Ge'ez text...",
        "syriac": "Syriac text...",
        "coptic": "Coptic text...",
        "armenian": "Armenian text..."
