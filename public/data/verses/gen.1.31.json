    "sourceTexts": {
        "hebrew": "וַיַּרְא אֱלֹהִים אֶת כָּל אֲשֶׁר עָשָׂה וְהִנֵּה טוֹב מְאֹד וַיְהִי עֶרֶב וַיְהִי בֹקֶר יוֹם הַשִּׁשִּׁי",
        "aramaic": "Aramaic targum text...",
        "greek": "καὶ εἶδεν ὁ θεὸς τὰ πάντα ὅσα ἐποίησεν καὶ ἰδοὺ καλὰ λίαν καὶ ἐγένετο ἑσπέρα καὶ ἐγένετο πρωί ἡμέρα ἕκτη",
        "latin": "viditque Deus cuncta quae fecit et erant valde bona et factum est vespere et mane dies sextus",
        "geez": "Ge'ez text...",
        "syriac": "Syriac text...",
        "coptic": "Coptic text...",
        "armenian": "Armenian text..."
