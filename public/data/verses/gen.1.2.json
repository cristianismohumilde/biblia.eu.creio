    "sourceTexts": {
        "hebrew": "וְהָאָרֶץ הָיְתָה תֹהוּ וָבֹהוּ וְחֹשֶׁךְ עַל פְּנֵי תְהוֹם וְרוּחַ אֱלֹהִים מְרַחֶפֶת עַל פְּנֵי הַמָּיִם",
        "aramaic": "וְאַרְעָא הֲוָת צָדְיָא וְרֵיקָנְיָא וַחֲשׁוֹכָא עַל אַפֵּי תְהוֹמָא וְרוּחָא מִן קֳדָם יְיָ מְנַשְּׁבָא עַל אַפֵּי מַיָּא",
        "greek": "ἡ δὲ γῆ ἦν ἀόρατος καὶ ἀκατασκεύαστος καὶ σκότος ἐπάνω τῆς ἀβύσσου καὶ πνεῦμα θεοῦ ἐπεφέρετο ἐπάνω τοῦ ὕδατος",
        "latin": "Terra autem erat inanis et vacua et tenebrae erant super faciem abyssi et spiritus Dei ferebatur super aquas",
        "geez": "ወምድርሰ ኢትሬአይ ወኢተደልወት ወጽልመት ላዕለ ቀላይ ወመንፈሰ እግዚአብሔር ይጼልል ላዕለ ማይ",
        "syriac": "ܘܐܪܥܐ ܗܘܬ ܬܘܗ ܘܒܘܗ ܘܚܫܘܟܐ ܥܠ ܐܦܝ ܬܗܘܡܐ ܘܪܘܚܗ ܕܐܠܗܐ ܡܪܚܦܐ ܗܘܬ ܥܠ ܐܦܝ ܡܝܐ",
        "coptic": "p-kahi de ne u-at-nau pe nem u-at-sobte pe nem u-kaki hi-jen p-nūn nem u-pneuma nte phnuti ne f-phēu hi-jen ni-mōu pe",
        "armenian": "Եւ երկիրն էր աներեւոյթ եւ անպատրաստ. եւ խաւար ի վերայ անդնդոց. եւ հոգի Աստուծոյ շրջէր ի վերայ ջուրց"
    },
    "hebrewWitnesses": [
        {
            "id": "leningradensis",
            "label": "Codex Leningradensis (B19A)",
            "text": "וְהָאָרֶץ הָיְתָה תֹהוּ וָבֹהוּ וְחֹשֶׁךְ עַל פְּנֵי תְהוֹם וְרוּחַ אֱלֹהִים מְרַחֶפֶת עַל פְּנֵי הַמָּיִם",
            "transliteration": "Ve-haaretz hayetah tohu va-vohu ve-choshek al penei tehom ve-ruach Elohim merachefet al penei hamayim",
            "literalPt": "E a terra era vã e vazia, e trevas [estavam] sobre a face do abismo, e o Espírito de Deus pairava sobre a face das águas."
        }
    ],
    "greekWitnesses": [
        {
            "id": "lxx",
            "label": "Septuaginta (LXX)",
            "text": "ἡ δὲ γῆ ἦν ἀόρατος καὶ ἀκατασκεύαστος καὶ σκότος ἐπάνω τῆς ἀβύσσου καὶ πνεῦμα θεοῦ ἐπεφέρετο ἐπάνω τοῦ ὕδατος",
            "transliteration": "he de ge en ahoratos kai akataskeuastos kai skotos epano tes abyssou kai pneuma theou epephereto epano tou hydatos",
            "literalPt": "E a terra era invisível e inacabada, e trevas estavam sobre o abismo, e o espírito de Deus movia-se sobre a água."
        }
    ],
    "ptLiteralVerse": "E a terra era vã e vazia; e havia trevas sobre a face do abismo; e o Espírito de Deus pairava sobre a face das águas.",
    "enLiteralVerse": "And the earth was without form and void; and darkness was upon the face of the deep; and the Spirit of God moved upon the face of the waters.",
    "literalTranslations": [
