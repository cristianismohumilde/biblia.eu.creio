    "sourceTexts": {
        "hebrew": "בְּרֵאשִׁית בָּרָא אֱלֹהִים אֵת הַשָּׁמַיִם וְאֵת הָאָרֶץ",
        "aramaic": "בקדמין ברא יי ית שמיא וית ארעא",
        "greek": "Εν αρχη εποιησεν ο θεος τον ουρανον και την γην",
        "latin": "In principio creavit Deus caelum et terram",
        "geez": "በመጀመሪያ ፈጠረ እግዚአብሔር ሰማይን እና ምድርን",
        "syriac": "ܒܪܫܝܬ ܒܪܐ ܐܠܗܐ ܫܡܝܐ ܘܐܪܥܐ",
        "coptic": "Hn te-hē arxe af-thamio m-petfe nem p-kahi",
        "armenian": "Սկզբում Աստված ստեղծեց երկինքն ու երկիրը"
    },
